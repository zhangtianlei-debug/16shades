# Production only: exact HTTPS origin. Keep blank for local development.
# To enable indexing, it must match publicOrigin in release.json.
SHADOW16_ORIGIN=
# Generate once on the server, keep unchanged across releases, never commit.
SHADOW16_SECRET=
SHADOW16_DATABASE=var/accounts.sqlite
SHADOW16_STATIC=dist/client
PORT=3106
# Disabled by default. This project never sends analytics to a remote service.
SHADOW16_ANALYTICS=false
# Optional after a real domain is added to Baidu. Never substitute an account password/API key.
SHADOW16_BAIDU_SITE_ID=

# Independent public content releases; keep outside application release directories.
SHADOW16_CONTENT_ROOT=var/content
