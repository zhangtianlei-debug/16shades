{
  "name": "16shades",
  "version": "0.1.0",
  "private": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "node scripts/build-site.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "preview:build": "node server/run.mjs --preview",
    "test:accounts": "node --test server/accounts.test.mjs app/prototype/account-api.test.mjs",
    "test:static": "node --test server/encoding.test.mjs",
    "test:local-results": "node --test app/prototype/local-result.test.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "test:i18n": "node scripts/check-i18n.mjs",
    "test:report": "node --test app/prototype/personal-report.test.mjs",
    "content:check": "node scripts/publish-content.mjs --check",
    "content:publish": "node scripts/publish-content.mjs",
    "test:content": "node --test server/content.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "altcha": "3.2.2",
    "altcha-lib": "2.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "sharp": "0.34.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
